# Copy to .env at the repo root. Docker compose reads it; for running the API with Maven, export these
# variables in your shell or IDE run configuration.

# --- Database ---
POSTGRES_USER=leadtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadtracker
# Used when running the API outside Docker
DB_URL=jdbc:postgresql://localhost:5432/leadtracker
DB_USERNAME=leadtracker
DB_PASSWORD=change-me

# --- API ---
PORT=4000
# Long random string, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# How long a sign-in lasts
SESSION_TTL_HOURS=12
# Business timezone, used to decide what "today" is for follow-ups
APP_TIMEZONE=Asia/Kolkata
# Send the session cookie over HTTPS only. Keep true in production; false for http://localhost
COOKIE_SECURE=false
# Only needed if the web app is served from a different origin than the API
CORS_ORIGIN=

# --- First admin account (created on startup when there are no users) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
# true adds 8 demo leads when the database has none (development only)
SEED_SAMPLE_LEADS=false

# --- Docker compose ---
WEB_PORT=8080
