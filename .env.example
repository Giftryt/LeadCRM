# Copy to .env at the repo root (used by docker compose) and to apps/api/.env for local development.

# --- Database ---
POSTGRES_USER=leadtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadtracker
DATABASE_URL=postgresql://leadtracker:change-me@localhost:5432/leadtracker?schema=public

# --- API ---
NODE_ENV=development
PORT=4000
# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# How long a sign-in lasts
SESSION_TTL_HOURS=12
# Business timezone, used to decide what is "today" for follow-ups
APP_TIMEZONE=Asia/Kolkata
# Origin of the web app (only needed when the web app is served from a different origin than the API)
CORS_ORIGIN=http://localhost:5173

# --- First admin account (created by `npm run db:seed` if no users exist) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
# Set to true to also create sample leads (development only)
SEED_SAMPLE_LEADS=false

# --- Docker compose ---
WEB_PORT=8080
# Keep true when served over HTTPS (production). Set false only to try the stack on plain http://localhost
COOKIE_SECURE=true
